# Dependencies and build output
node_modules/
sites/command/dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
tests/e2e/.artifacts/
.serve-logs/

# Secrets. Nothing in this project needs a server-side secret; these are here so that
# one can never be committed by accident.
.env
.env.*
!.env.example

# TrustRegistry signing key (private half). The public half and the signed attestations
# are published; the private key never leaves the machine that signs.
sites/trustregistry/.keys/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Demo film: the recordings and renders are large and regenerated by scripts; the
# narration and the music bed are regenerated by `npm run video:voice` (video/demo/script/tts_edge.py, make-music.py).
video/footage/*.webm
video/demo/assets/footage/
video/demo/assets/voice/*.wav
video/demo/assets/voice/*.mp3
video/demo/assets/music/bed.wav
video/demo/assets/voice/transcript.json
video/demo/renders/
video/demo/.hyperframes/
video/demo/review/
video/demo/node_modules/
video/demo/.thumbnails/
video/demo/.transcode-cache/
submission/
